    <model name="west">
      <static>true</static>
      <pose>-3 0 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 6 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 6 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="obstacle">
      <static>true</static>
      <pose>0 1.5 0.35 0 0 0</pose>
      <link name="box">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 0.7</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="portfolio_robot">
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0.14 0 0 0</pose>
        <inertial>
          <!-- Rear battery places the COM inside the wheel/caster support triangle. -->
          <pose>-0.05 0 -0.02 0 0 0</pose>
          <mass>2</mass>
          <inertia>
            <ixx>0.02</ixx>
            <iyy>0.03</iyy>
            <izz>0.04</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.35 0.25 0.12</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.35 0.25 0.12</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.2 0.6 0.8 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.12 0 0 0</pose>
          <topic>/scan</topic>
          <gz_frame_id>laser</gz_frame_id>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <ray>
            <scan>
              <horizontal>
                <samples>361</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.05</min>
              <max>10</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose>0 0.15 0.1 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.15 0.1 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
      <link name="caster">
        <pose>-0.13 0 0.05 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
      <joint name="left_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
        </axis>
      </joint>
      <joint name="right_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
        </axis>
      </joint>
      <joint name="caster_joint" type="fixed">
        <parent>base_link</parent>
        <child>caster</child>
      </joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint>
        <right_joint>right_joint</right_joint>
        <wheel_separation>0.3</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <topic>/cmd_vel_safe</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_velocity>0.3</max_linear_velocity>
        <max_angular_velocity>1.2</max_angular_velocity>
        <min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_linear_acceleration>0.5</max_linear_acceleration>
        <min_angular_acceleration>-0.5</min_angular_acceleration>
        <max_angular_acceleration>0.5</max_angular_acceleration>
      </plugin>
    </model>
  </world>
</sdf>

